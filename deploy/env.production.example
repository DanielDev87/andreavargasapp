# Plantilla para el .env real de producción — NUNCA se sube por el pipeline ni se
# commitea. Cópialo a mano por SSH la primera vez:
#   cp deploy/env.production.example .env
# y luego llena los valores marcados abajo. Después de crearlo, corre:
#   php artisan key:generate
#   php artisan storage:link
#   php artisan migrate --force

APP_NAME=AndreavargasApp
APP_ENV=production
APP_KEY=
# false en producción SIEMPRE — con true, cualquier error muestra stack traces,
# rutas del servidor y a veces hasta valores de .env directamente al navegador.
APP_DEBUG=false
# Se usa para generar URLs absolutas (links en correos, assets, etc.) y como dominio
# EHLO del correo saliente — no es solo cosmético, tiene que ser el dominio real.
APP_URL=https://draandreavargas.art

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'error' en producción — 'debug' (el default local) llena el log con demasiado ruido.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Crear en cPanel → Bases de datos MySQL (wizard), NO por SQL directo — shared hosting
# normalmente no da acceso a consola SQL. cPanel antepone tu usuario cPanel al nombre,
# ej. "usuario_artsmile" en vez de "artsmile".
DB_DATABASE=TU-DB-AQUI
DB_USERNAME=TU-DB-USER-AQUI
DB_PASSWORD=TU-DB-PASSWORD-AQUI

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true en producción, ya que el sitio corre sobre HTTPS real — evita que la cookie de
# sesión se pueda interceptar en una conexión no cifrada.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Correo real vía la cuenta de correo del dominio (cPanel → Correo → Cuentas de correo).
# Puerto 465 = SSL implícito → scheme "smtps" (no "tls", ese es para el puerto 587).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.draandreavargas.art
MAIL_PORT=465
MAIL_USERNAME=no-responder@draandreavargas.art
MAIL_PASSWORD=TU-PASSWORD-DE-ESA-CUENTA-DE-CORREO-AQUI
MAIL_FROM_ADDRESS="no-responder@draandreavargas.art"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider — usado por AIValidationService para verificar diploma + cédula.
# Sin esta clave, el sistema cae a un modo de respaldo (puntaje fijo 0.65, requiere
# revisión manual en /admin/validations) — no es obligatorio para lanzar, pero conviene
# decidirlo antes: ¿vas a validar todo a mano al principio, o activar esto ya?
# Claude (console.anthropic.com > API Keys): revisa diploma y documento de identidad
ANTHROPIC_API_KEY=
ANTHROPIC_VALIDATION_MODEL=claude-haiku-5-5

# Llaves de PRODUCCIÓN de Bold (Llave de Identidad → BOLD_API_KEY, Llave Secreta →
# BOLD_WEBHOOK_SECRET) — distintas a las de sandbox que usamos en desarrollo. El
# webhook de producción en el dashboard de Bold debe apuntar a:
#   https://draandreavargas.art/webhooks/bold
BOLD_API_KEY=TU-LLAVE-DE-IDENTIDAD-DE-PRODUCCION-AQUI
BOLD_API_BASE=
BOLD_WEBHOOK_SECRET=TU-LLAVE-SECRETA-DE-PRODUCCION-AQUI

# Mismo valor que el secreto DEPLOY_HOOK_TOKEN configurado en GitHub Actions — protege
# public_html/deploy-hook.php, que el pipeline llama después de cada subida por FTP
# para correr migraciones/caché (no hay SSH en este plan para hacerlo de otra forma).
DEPLOY_HOOK_TOKEN=TU-TOKEN-AQUI

# Bunny Stream (dash.bunny.net > Stream > tu librería > API)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=

# Correo donde se atienden solicitudes sobre datos personales (Ley 1581)
DATA_PROTECTION_EMAIL=
