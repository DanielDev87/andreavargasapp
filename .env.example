APP_NAME=AndreavargasApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=andreavargasapp
DB_USERNAME=andreavargasapp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log delivers to storage/logs/laravel.log — no local SMTP server required.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correo donde se atienden solicitudes sobre datos personales (Ley 1581)
DATA_PROTECTION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider — used by AIValidationService to verify diploma + ID documents
# Claude (console.anthropic.com > API Keys): revisa diploma y documento de identidad
ANTHROPIC_API_KEY=
ANTHROPIC_VALIDATION_MODEL=claude-haiku-5-5
OPENAI_API_KEY=

# Bold payment gateway
BOLD_API_KEY=
BOLD_API_BASE=
BOLD_WEBHOOK_SECRET=
# true con las llaves de PRUEBAS de Bold; false con las de producción
BOLD_SANDBOX=true

# Deploy pipeline: protects public_html/deploy-hook.php, which the GitHub Actions
# deploy workflow calls after an FTP upload to run migrate/cache/queue:restart on
# hosts without SSH. Only needed in production — generate with `openssl rand -hex 32`.
DEPLOY_HOOK_TOKEN=

# Bunny Stream (dash.bunny.net > Stream > tu librería > API)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
# ID del video de presentación de la doctora (botón "Conoce a tu Doctora" del home)
BUNNY_STREAM_INTRO_VIDEO_ID=
